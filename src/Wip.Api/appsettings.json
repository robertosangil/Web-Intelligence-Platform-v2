{
  "AllowedHosts": "*",
  "App": {
    "EmailConfirmSuccessRedirect": "/email-confirmed",
    "EmailConfirmFailedRedirect": "/email-confirmation-failed"
  },
  "ConnectionStrings": {
    "WipDatabase": "",
    "DefaultConnection": "Server=localhost;Database=WIPv2;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "PasswordReset": {
    "TokenExpiryMinutes": 30,
    "RateLimitWindowMinutes": 15,
    "RateLimitPerEmail": 3,
    "RateLimitPerIp": 10,
    "ResetPath": "/reset-password"
  },
  "Smtp": {
    "Host": "",
    "Port": 2525,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "WIP Admin"
  },
  "Smtp2Go": {
    "BaseUrl": "https://api.smtp2go.com/",
    "ApiKey": "",
    "FromEmail": ""
  },
  "Jwt": {
    "Issuer": "Wip.Api",
    "Audience": "Wip.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DurationMinutes": 15
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

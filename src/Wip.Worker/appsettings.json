{
  "ConnectionStrings": {
    "WipDatabase": ""
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DurationMinutes": 15
    }
  },
  "CollectionScheduler": {
    "Enabled": false,
    "MaxConcurrency": 4,
    "PollIntervalSeconds": 60,
    "Definitions": [
      { "Provider": "Cloudflare", "CollectorKey": "daily", "Interval": "1.00:00:00", "Enabled": true },
      { "Provider": "GoDaddy", "CollectorKey": "daily", "Interval": "1.00:00:00", "Enabled": true },
      { "Provider": "cPanel", "CollectorKey": "daily", "Interval": "1.00:00:00", "Enabled": true },
      { "Provider": "WpUmbrella", "CollectorKey": "daily", "Interval": "1.00:00:00", "Enabled": true }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
